@{
}

<h1>Menu for @ViewBag.Day</h1>
@if (Model.Count == 0)
{
    <p>No specials today. Come back tomorrow.</p>
}
else
{
    int spicy_count = 0;
    foreach (Dish each_dish in Model)
    {
        if (each_dish.IsSpicy) { spicy_count++; }
        
    }
    <p>@Model.Count specials, @spicy_count spicy</p>
}

@model List<Dish>
@foreach (Dish each_dish in Model)
{
<partial
    name = "_DishCard"
    model= "each_dish"
/>
}